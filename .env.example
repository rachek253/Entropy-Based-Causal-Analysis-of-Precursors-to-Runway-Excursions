# ============================================================
# Project Environment Configuration
# ============================================================
# Copy this file to `.env` and update the paths for your system.
# Do NOT commit your actual `.env` file to GitHub.

# Base directory where all project data is stored
PROJECT_DATA_DIRECTORY=path/to/your/project/data

# Example (Windows):
# PROJECT_DATA_DIRECTORY=C:/Users/yourname/ProjectData

# Example (Mac/Linux):
# PROJECT_DATA_DIRECTORY=/Users/yourname/ProjectData
